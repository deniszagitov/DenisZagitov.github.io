---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import SpatialExpertise from './SpatialExpertise.astro';
import CareerBrands from './CareerBrands.astro';
import { content, experience, archivePath, resumePath, documentCount, type Locale } from '../data/profile';
import diplomas from '../data/diplomas.json';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
const selectedYears = [2019, 2018, 2017];
const previews = selectedYears.map(year => diplomas.filter(d => d.year === year && d.thumbnail)[0]).filter(Boolean);
---
<SiteLayout locale={locale}>
  <section class="hero container" aria-labelledby="hero-name">
    <div class="hero-copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 id="hero-name">{c.firstName}<br /><span class="hero-surname">{c.lastName}<span class="accent">.</span></span><span class="hero-role">{c.role}</span></h1>
      <p class="hero-intro">{c.intro}</p>
      <div class="hero-actions"><a class="button primary" href="#experience">{c.seeExperience}<Icon name="down" size={17} /></a><a class="text-link" href={resumePath(locale)}>{c.resume}<Icon name="arrow" size={17} /></a></div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-frame" data-tilt><img src="/media/denis-zagitov.webp" alt={c.portraitAlt} width="720" height="720" fetchpriority="high" /><span class="portrait-corner" aria-hidden="true">D / Z</span></div>
      <figcaption><span>{c.portraitCaption}</span><span class="location"><span class="location-dot" aria-hidden="true"></span>{c.location}</span></figcaption>
    </figure>
    <div class="hero-facts"><div class="fact"><span class="fact-value">10<span class="accent">+</span></span><span class="fact-caption">{c.years}</span></div><div class="fact"><span class="fact-value">≈50 <span class="fact-unit">{locale === 'ru' ? 'ТБ' : 'TB'}</span></span><span class="fact-caption">{c.scale}</span><span class="fact-note">{c.scaleNote}</span></div><a class="fact fact-link" href="https://www.linkedin.com/in/deniszagitov/" target="_blank" rel="noopener noreferrer"><span class="fact-word">Data<span class="accent"> → </span>AI<Icon name="arrow" size={20} /></span><span class="fact-caption">{locale === 'ru' ? 'От платформ данных до ML-инфраструктуры' : 'From data platforms to ML infrastructure'}</span></a></div>
  </section>

  <section class="profile section container" id="about" aria-labelledby="profile-heading">
    <div class="section-label"><span>{c.profileLabel}</span><span class="section-line" aria-hidden="true"></span></div>
    <div class="profile-grid"><h2 class="preserve-lines" id="profile-heading">{c.profileHeading}</h2><div class="profile-text"><p class="lead">{c.profileLead}</p><p>{c.profileBody}</p><p class="personal-note">{c.personal}</p></div></div>
    <SpatialExpertise locale={locale} />
  </section>

  <section class="experience-section section" id="experience" aria-labelledby="experience-heading"><div class="container">
    <div class="section-label"><span>{c.experienceLabel}</span><span class="section-line" aria-hidden="true"></span></div>
    <div class="section-heading-row"><div><h2 class="preserve-lines" id="experience-heading">{c.experienceHeading}</h2><p class="section-intro">{c.experienceIntro}</p></div><a class="text-link" href={resumePath(locale)}>{c.fullResume}<Icon name="arrow" size={18} /></a></div>
    <CareerBrands locale={locale} />
    <div class="timeline">{experience.map((job, index) => <article class="timeline-item" id={`career-${job.id}`}><div class="timeline-period"><span class:list={['timeline-marker', { current: job.current }]} aria-hidden="true"></span>{job.period}{job.current ? ` ${c.present}` : ''}</div><div class="timeline-company"><p class="company-name">{locale === 'en' && 'companyEn' in job ? job.companyEn : job.company}{index === 0 && <span class="current-mark" aria-label={c.present}></span>}</p><h3>{job[locale].role}</h3></div><div class="timeline-description"><p>{job[locale].summary}</p><p class="timeline-detail">{job[locale].detail}</p><div class="tags">{job.tags.map(tag => <span>{tag}</span>)}</div></div></article>)}</div>
    <p class="experience-source"><a href="https://www.linkedin.com/in/deniszagitov/" target="_blank" rel="noopener noreferrer">{c.source}<Icon name="arrow" size={14} /></a></p>
  </div></section>

  <section class="approach section container" aria-labelledby="approach-heading"><div class="section-label"><span>{c.approachLabel}</span><span class="section-line" aria-hidden="true"></span></div><h2 class="preserve-lines" id="approach-heading">{c.approachHeading}</h2><div class="approach-grid">{c.approach.map((item, i) => <article><span class="approach-number">0{i + 1}<span aria-hidden="true"> /</span></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>

  <section class="archive-teaser section" aria-labelledby="archive-heading"><div class="container archive-teaser-grid"><div class="archive-teaser-copy"><div class="section-label"><span>{c.archiveLabel}</span></div><h2 class="preserve-lines" id="archive-heading">{c.archiveHeading}</h2><p>{c.archiveIntro}</p><a class="text-link" href={archivePath(locale)}>{c.archiveLink}<Icon name="arrow" size={19} /></a><div class="archive-count"><span>{documentCount(diplomas.length, locale)}</span><span>2002 — 2019</span></div></div><a class="diploma-stack" href={archivePath(locale)} aria-label={c.archiveLink}>{previews.map((diploma, i) => <div class:list={['stack-sheet', `sheet-${i}`]}><img src={diploma.thumbnail!} alt={`${c.image}, ${diploma.year}`} width="360" height="480" loading="lazy" /></div>)}<span class="stack-caption">{locale === 'ru' ? 'Личный архив / по годам' : 'Personal archive / by year'}<Icon name="arrow" size={16} /></span></a></div></section>

  <section class="contact-section section container" id="contact" aria-labelledby="contact-heading"><div class="section-label"><span>{c.contactLabel}</span><span class="section-line" aria-hidden="true"></span></div><div class="contact-grid"><div><h2 id="contact-heading">{c.contactHeading}</h2><p>{c.contactText}</p></div><div class="contact-links"><a class="contact-email" href="mailto:deniszagitov@gmail.com">deniszagitov@gmail.com<Icon name="arrow" size={25} /></a><div class="social-links"><a href="https://www.linkedin.com/in/deniszagitov/" target="_blank" rel="noopener noreferrer">LinkedIn<Icon name="arrow" size={16} /></a><a href="https://github.com/DenisZagitov" target="_blank" rel="noopener noreferrer">GitHub<Icon name="arrow" size={16} /></a><a href="https://t.me/DenisZagitov" target="_blank" rel="noopener noreferrer">Telegram<Icon name="arrow" size={16} /></a></div></div></div></section>
</SiteLayout>
